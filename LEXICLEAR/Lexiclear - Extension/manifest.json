{
  "manifest_version": 3,
  "name": "Legal Risk Analyzer",
  "version": "1.0.0",
  "description": "Analyze web pages for legal risk factors, fake website detection, and compliance concerns.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:5000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Legal Risk Analyzer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
