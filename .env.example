# Copy to .env and add your API keys

# Legal Risk Analyzer (Gemini)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Fake Website Detection - stronger verification (optional but recommended)
# Google Safe Browsing: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=
# VirusTotal: https://www.virustotal.com/gui/join-us (free tier available)
VIRUSTOTAL_API_KEY=